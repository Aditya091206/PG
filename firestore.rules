rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwner() {
      return isAuthenticated() && request.auth.token.role == 'owner';
    }

    function isStudent() {
      return isAuthenticated() && request.auth.token.role == 'student';
    }

    function isPGOwner(pgId) {
      return isOwner() && (
        request.auth.token.pgId == pgId ||
        (request.auth.token.ownedPgIds != null && pgId in request.auth.token.ownedPgIds) ||
        (exists(/databases/$(database)/documents/pgs/$(pgId)) &&
          get(/databases/$(database)/documents/pgs/$(pgId)).data.ownerId == request.auth.uid)
      );
    }

    function isApprovedStudent(pgId) {
      return isStudent() &&
        request.auth.token.pgId == pgId &&
        request.auth.token.isApproved == true;
    }

    function isPGMember(pgId) {
      return isPGOwner(pgId) || isApprovedStudent(pgId);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isUser(userId) || isOwner();
      allow create: if isUser(userId) &&
        request.resource.data.role == 'unassigned' &&
        !request.resource.data.keys().hasAny(['ownedPgIds']);
      allow update: if isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isUser(userId);
    }

    // PG Code Lookup Table (Server managed)
    match /pg_codes/{code} {
      allow read: if isAuthenticated();
      allow write: if false; // Generated and locked only via Cloud Functions
    }

    // Property Documents and Subcollections
    match /pgs/{pgId} {
      allow read: if isPGMember(pgId) || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid
      );
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isPGOwner(pgId);
      allow delete: if isPGOwner(pgId);

      // Rooms
      match /rooms/{roomId} {
        allow read: if isPGMember(pgId);
        allow write: if isPGOwner(pgId);
      }

      // Individual Beds
      match /beds/{bedId} {
        allow read: if isPGMember(pgId);
        allow write: if isPGOwner(pgId);
      }

      // PG Students
      match /students/{studentId} {
        allow read: if isPGOwner(pgId) || (isApprovedStudent(pgId) && request.auth.uid == studentId);
        allow write: if isPGOwner(pgId);
      }

      // Join Requests
      match /join_requests/{requestId} {
        allow read: if isPGOwner(pgId) || (
          isAuthenticated() && (
            (resource != null && resource.data.studentId == request.auth.uid) ||
            request.resource.data.studentId == request.auth.uid
          )
        );
        allow create: if isAuthenticated() &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.status == 'PENDING';
        allow update: if isPGOwner(pgId);
        allow delete: if isPGOwner(pgId);
      }

      // Daily Meals & Weekly Menu
      match /meals/{date} {
        allow read: if isPGMember(pgId);
        allow create, delete: if isPGOwner(pgId);
        allow update: if isPGOwner(pgId) || (
          isApprovedStudent(pgId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['optOutStudentIds', 'feedback'])
        );
      }

      // Broadcast Notices
      match /notices/{noticeId} {
        allow read: if isPGMember(pgId);
        allow write: if isPGOwner(pgId);
      }

      // Maintenance & Repair Tickets
      match /tickets/{ticketId} {
        allow read: if isPGMember(pgId);
        allow create: if isApprovedStudent(pgId) &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.status == 'OPEN';
        allow update: if isPGOwner(pgId) || (
          isApprovedStudent(pgId) &&
          resource.data.studentId == request.auth.uid
        );
        allow delete: if isPGOwner(pgId);
      }

      // Cleaning Schedule
      match /cleaning/{cleaningId} {
        allow read: if isPGMember(pgId);
        allow write: if isPGOwner(pgId);
      }

      // Rent and Fee Dues
      match /dues/{dueId} {
        allow read: if isPGOwner(pgId) || (
          isApprovedStudent(pgId) && resource.data.studentId == request.auth.uid
        );
        allow write: if isPGOwner(pgId);
      }

      // Visitor Gate Logs
      match /visitors/{visitorId} {
        allow read: if isPGMember(pgId);
        allow create: if isApprovedStudent(pgId) && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if isPGOwner(pgId);
      }

      // Gate Passes
      match /gate_passes/{passId} {
        allow read: if isPGOwner(pgId) || (
          isApprovedStudent(pgId) && resource.data.studentId == request.auth.uid
        );
        allow create: if isApprovedStudent(pgId) &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.status == 'PENDING';
        allow update: if isPGOwner(pgId);
        allow delete: if isPGOwner(pgId);
      }

      // Move-out / Notice Requests
      match /move_out_requests/{reqId} {
        allow read: if isPGOwner(pgId) || (
          isApprovedStudent(pgId) && resource.data.studentId == request.auth.uid
        );
        allow create: if isApprovedStudent(pgId) &&
          request.resource.data.studentId == request.auth.uid;
        allow update: if isPGOwner(pgId);
        allow delete: if isPGOwner(pgId);
      }
    }
  }
}
